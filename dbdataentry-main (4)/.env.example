# ===== WAJIB (isi di Vercel > Project > Settings > Environment Variables) =====

# Upstash Redis (REST). Integrasi Vercel Marketplace mengisi KV_REST_API_URL / KV_REST_API_TOKEN;
# keduanya juga dikenali sebagai pengganti.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Akun Superadmin (role tertinggi, permanen, tidak bisa diubah/ditangguhkan dari dashboard).
# Hash dibuat dengan: npm run hash -- "password-anda"   (Argon2id; bcrypt juga diterima)
# Di file .env/.env.local setiap $ harus ditulis \$ ; di dashboard Vercel tidak perlu.
# ADMIN_USERNAME / ADMIN_PASSWORD_HASH (nama lama) masih diterima sebagai alias.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD_HASH=

# Kunci penanda tangan JWT, minimal 32 karakter acak:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Kunci enkripsi AES-256-GCM (hex 32-byte / 64 karakter) untuk Webhook Secret di Redis:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ===== OPSIONAL =====

# Rotasi ENCRYPTION_KEY: saat mengganti kunci, isi ini dengan kunci LAMA, redeploy, lalu klik
# "Enkripsi ulang sekarang" di tab Sistem. Setelah selesai, hapus variabel ini.
# ENCRYPTION_KEY_PREVIOUS=

# Pembersihan log otomatis harian (Vercel Cron, lihat vercel.json). Vercel mengirimnya sebagai
# "Authorization: Bearer <CRON_SECRET>". Kosong = endpoint cron menolak semua request.
# CRON_SECRET=

# Jika diisi, /api/receiver/universal menolak request tanpa token ini ATAU API Key dashboard yang valid
# (header x-api-key, Authorization: Bearer, atau ?key=). Kosong = terbuka, kecuali Superadmin menyalakan
# "Wajibkan API Key" di tab Sistem.
# WEBHOOK_INGEST_TOKEN=

# Batas penyimpanan
# LOG_MAX_PER_TABLE=500
# LOG_MAX_STREAM=500
# MAX_GAME_TABLES=100

# Lookup ISP via layanan eksternal saat login (Vercel tidak menyediakan ISP). off = nonaktif.
# GEOIP_ISP_LOOKUP=off

# Interval polling SSE (ms, 2000-60000) dan batas memori paket Redis (MB) untuk persentase di dashboard
# STREAM_INTERVAL_MS=4000
# REDIS_MEMORY_LIMIT_MB=256

# ---------- v5.2: enkripsi berlapis, antrean, alert ----------
# KEK (Key Encryption Key) aktif = ENCRYPTION_KEY (hex 64). Buat: openssl rand -hex 32
# Rotasi tanpa downtime: pindahkan kunci lama ke ENCRYPTION_KEY_PREVIOUS (atau daftar koma di
# ENCRYPTION_KEYS_RETIRED bila ada beberapa generasi), isi ENCRYPTION_KEY dengan kunci baru, redeploy.
# Cron /api/cron/crypto-rotate (atau tombol Superadmin) membungkus ulang DEK semua rahasia; setelah
# "gagal 0" kunci lama boleh dibuang.
# ENCRYPTION_KEYS_RETIRED=

# Antrean ingest (dinyalakan Superadmin di tab Sistem > Antrean ingest; bawaan MATI)
# QUEUE_MAX_DEPTH=5000          # batas item menunggu; lebih dari ini request ditolak 503 (backpressure)
# QUEUE_MAX_ITEM_BYTES=24576    # payload lebih besar diproses langsung, tidak diantre
# QUEUE_LEASE_SECONDS=60        # lease klaim; lewat ini item dianggap macet dan diambil ulang
# QUEUE_MAX_ATTEMPTS=5          # setelah ini item masuk dead-letter
# QUEUE_ALERT_DEPTH=2000        # kedalaman yang memicu alert "antrean menumpuk"

# Ambang alert lonjakan kejadian keamanan / error ingest per jam
# SECURITY_SPIKE_PER_HOUR=50
